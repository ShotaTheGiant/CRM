rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /deals/{id} {
      // Only these Google accounts can read or write deals. Replace both emails.
      allow read, write: if request.auth != null
        && request.auth.token.email in ['YOUR_EMAIL@gmail.com', 'PARTNER_EMAIL@gmail.com'];
    }
  }
}
